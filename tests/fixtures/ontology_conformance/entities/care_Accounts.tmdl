entity care_Accounts
	backingTable: care_account
	keyProperty: account_key
	property account_key
		dataType: int64
		backingConfiguration
			valueColumn: care_account.account_key
	property account_id
		dataType: string
		backingConfiguration
			valueColumn: care_account.account_id
	property market_id
		dataType: string
		backingConfiguration
			valueColumn: care_account.market_id
	property region
		dataType: string
		backingConfiguration
			valueColumn: care_account.region
	property consent
		dataType: boolean
		backingConfiguration
			valueColumn: care_account.consent
	property enterprise
		dataType: boolean
		backingConfiguration
			valueColumn: care_account.enterprise
	property display_name
		dataType: string
		backingConfiguration
			valueColumn: care_account.display_name
