expression 'DirectQuery to AS - SYNTHETIC_WORKSPACE/SYNTHETIC_NETWORK' =
	let
		Source = AnalysisServices.Database("powerbi://api.powerbi.com/v1.0/SYNTHETIC_WORKSPACE", "Synthetic network"),
		Cubes = Table.Combine(Source[Data]),
		Cube = Cubes{[Id="Model", Kind="Cube"]}[Data]
	in
		Cube

