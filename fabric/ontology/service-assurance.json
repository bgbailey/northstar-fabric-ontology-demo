  "rules": [
    {
      "id": "R1",
      "name": "ExposureNeedsOverlap",
      "linkedTo": [
        "network_Incidents",
        "enterprise_ServiceSiteMap",
        "enterprise_Contracts"
      ],
      "statement": "A service is exposed to an incident only when the incident interval, the service-site assignment and the contract are valid at the same time. Validity periods are half-open UTC intervals."
    },
    {
      "id": "R2",
      "name": "CreditPerContractMonth",
      "linkedTo": [
        "enterprise_Contracts",
        "enterprise_SlaEvaluation",
        "enterprise_AppliedCredits"
      ],
      "statement": "SLA credit is evaluated per service-month against its threshold, then capped once per contract-month. It is a whole-month settlement, not a loss caused by one incident. Never allocate it to an incident and never apply the cap twice. Credit exposure is eligible credit minus applied credit, as defined by the source measure."
    },
    {
      "id": "R3",
      "name": "FinancePerAccountMonth",
      "linkedTo": [
        "enterprise_Accounts",
        "finance_Accounts",
        "finance_AccountMonth"
      ],
      "statement": "Recognized revenue and margin are stated per account and month. Bring the list of accounts down to one row per account-month before looking up finance measures, so that several contracts or services never multiply revenue or margin. Credits posted in Finance are not netted against Enterprise services credits."
    },
    {
      "id": "R4",
      "name": "IdentityIsAccountKey",
      "linkedTo": [
        "network_Accounts",
        "enterprise_Accounts",
        "finance_Accounts",
        "care_Accounts"
      ],
      "statement": "The account key identifies a customer in every model. Display names are not identity. A billing key is not an account key even when the numbers match; map it through the billing account map for the service date."
    },
    {
      "id": "R5",
      "name": "UnknownIsNotZero",
      "linkedTo": [
        "network_Incidents",
        "network_Sites",
        "network_SiteHour",
        "network_Accounts",
        "enterprise_Sites",
        "enterprise_ServiceSiteMap",
        "enterprise_Services",
        "enterprise_ServiceMonth",
        "enterprise_Contracts",
        "enterprise_SlaEvaluation",
        "enterprise_AppliedCredits",
        "enterprise_Accounts",
        "finance_Accounts",
        "finance_AccountMonth",
        "care_Accounts",
        "care_Cases",
        "care_CaseDailySnapshot"
      ],
      "statement": "A missing mapping, an absent credit row or a period with no data is unknown. Report it as an exclusion. Do not sum ratios, distinct counts or daily snapshots over time; ask the source measure at the final grain."
    }
  ],
  "businessQuestion": "Which enterprise customers were served from sites hit by July incidents, what SLA credit exposure do we carry on their contracts, how much revenue and margin is at stake, and who already has escalated cases?",
  "checks": [
    "G1",
    "G2",
    "G3",
    "G4",
