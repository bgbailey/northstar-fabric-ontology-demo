/// Four synthetic home markets; home market is not network exposure.
table 'Markets'
	lineageTag: 511bf073-5af1-56fd-95f6-8d2a46dd541d

	/// Technical identity; join only through the declared mapping.
	column 'market_id'
		dataType: string
		summarizeBy: none
		sourceColumn: market_id
		lineageTag: b5752071-84b8-5958-994e-f141c4d183ac
		isHidden
		isAvailableInMdx: false
		isKey

	/// Market name at the declared Markets grain.
	column 'market_name'
		dataType: string
		summarizeBy: none
		sourceColumn: market_name
		lineageTag: 50bdbba9-fcf7-5861-865b-f28faf5e0512

	/// Region at the declared Markets grain.
	column 'region'
		dataType: string
		summarizeBy: none
		sourceColumn: region
		lineageTag: 673a8293-1e46-5670-94e2-de3a53de68b0

	partition 'Markets' = entity
		mode: directLake
		source
			entityName: market
			schemaName: dbo
			expressionSource: 'OneLake Source'
