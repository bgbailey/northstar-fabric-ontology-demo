/// Registered accounts, not active accounts; names are deliberately nonunique.
table 'Accounts'
	lineageTag: d7111859-91e9-5101-93a9-dc938420ce48

	/// Technical identity; join only through the declared mapping.
	column 'account_key'
		dataType: int64
		summarizeBy: none
		sourceColumn: account_key
		lineageTag: d8fba806-bdcf-58c5-b966-4a053ed81692
		isHidden
		isAvailableInMdx: false
		isKey
		formatString: #,##0

	/// Technical identity; join only through the declared mapping.
	column 'account_id'
		dataType: string
		summarizeBy: none
		sourceColumn: account_id
		lineageTag: 7f2bfb63-90d1-51f8-9184-6660799dde8a
		isHidden
		isAvailableInMdx: false

	/// Technical identity; join only through the declared mapping.
	column 'market_id'
		dataType: string
		summarizeBy: none
		sourceColumn: market_id
		lineageTag: efae4596-fea8-5cb7-88be-bdd8c97ed516
		isHidden
		isAvailableInMdx: false

	/// Region at the declared Accounts grain.
	column 'region'
		dataType: string
		summarizeBy: none
		sourceColumn: region
		lineageTag: d9137f69-08ca-5215-b11f-7e085ac34f6f

	/// Consent at the declared Accounts grain.
	column 'consent'
		dataType: boolean
		summarizeBy: none
		sourceColumn: consent
		lineageTag: 3c08c5dd-ea1a-568d-bc7a-954e0ab14f00

	/// Enterprise at the declared Accounts grain.
	column 'enterprise'
		dataType: boolean
		summarizeBy: none
		sourceColumn: enterprise
		lineageTag: 8be1784b-24de-5b8d-99c3-53554308ee6c

	/// Display name at the declared Accounts grain.
	column 'display_name'
		dataType: string
		summarizeBy: none
		sourceColumn: display_name
		lineageTag: 25d68075-60f2-5e39-9a1f-cfa8071d8811

	partition 'Accounts' = entity
		mode: directLake
		source
			entityName: account
			schemaName: dbo
			expressionSource: 'OneLake Source'
