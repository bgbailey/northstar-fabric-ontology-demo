/// Half-open serving-site history; service 1 moves mid-incident without overlapping mappings.
table 'Service Site Map'
	lineageTag: d3e84153-4f74-56c5-ac04-412684070107

	/// Hidden technical identifier; join only through declared relationships or identity maps.
	column 'service_key'
		dataType: int64
		summarizeBy: none
		sourceColumn: service_key
		lineageTag: 927ca55b-beb1-56a2-bd13-5dde17446fae
		isHidden
		isAvailableInMdx: false
		formatString: #,##0

	/// Hidden technical identifier; join only through declared relationships or identity maps.
	column 'site_key'
		dataType: int64
		summarizeBy: none
		sourceColumn: site_key
		lineageTag: 5e08fb99-9224-5572-b3c4-2babd39eae38
		isHidden
		isAvailableInMdx: false
		formatString: #,##0

	/// Hidden technical identifier; join only through declared relationships or identity maps.
	column 'contract_key'
		dataType: int64
		summarizeBy: none
		sourceColumn: contract_key
		lineageTag: c260f777-9d67-54e0-b042-c04372e53dae
		isHidden
		isAvailableInMdx: false
		formatString: #,##0

	/// Hidden UTC instant; half-open validity intervals include start and exclude end.
	column 'valid_from'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: valid_from
		lineageTag: a7193355-c89e-5ed3-b32b-bd2f5df55ac7
		isHidden
		isAvailableInMdx: false
		formatString: yyyy-MM-dd HH:mm:ss
		annotation Timezone = UTC

	/// Hidden UTC instant; half-open validity intervals include start and exclude end.
	column 'valid_to'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: valid_to
		lineageTag: 42ef5d6e-754a-5ebc-a9c4-036a5c670b2f
		isHidden
		isAvailableInMdx: false
		formatString: yyyy-MM-dd HH:mm:ss
		annotation Timezone = UTC

	/// Hidden technical identifier; join only through declared relationships or identity maps.
	column 'market_id'
		dataType: string
		summarizeBy: none
		sourceColumn: market_id
		lineageTag: c7e0c0cc-8fea-5f52-af46-24654b539643
		isHidden
		isAvailableInMdx: false

	/// Mapping start-month attribute only, not active serving-site validity; use UTC valid_from/valid_to.
	column 'month'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: month
		lineageTag: 43886de8-b7f5-5be2-8f57-86ccc78e7484
		formatString: yyyy-MM-dd

	partition 'Service Site Map' = entity
		mode: directLake
		source
			entityName: service_site_map
			schemaName: dbo
			expressionSource: 'OneLake Source'
