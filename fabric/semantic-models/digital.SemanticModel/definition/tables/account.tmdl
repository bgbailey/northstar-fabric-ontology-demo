/// Registered accounts, not active accounts; names are deliberately nonunique.
table 'Accounts'
	lineageTag: 21aeaa6b-0366-54e4-9be3-3cceb4050464

	/// Hidden technical identifier; join only through declared relationships or identity maps.
	column 'account_key'
		dataType: int64
		summarizeBy: none
		sourceColumn: account_key
		lineageTag: 3221629c-aa23-5f51-8546-7361ee668085
		isHidden
		isAvailableInMdx: false
		isKey
		formatString: #,##0

	/// Hidden technical identifier; join only through declared relationships or identity maps.
	column 'account_id'
		dataType: string
		summarizeBy: none
		sourceColumn: account_id
		lineageTag: bd9c0a18-a3d1-51ba-9a0c-acdc3afe446d
		isHidden
		isAvailableInMdx: false

	/// Hidden technical identifier; join only through declared relationships or identity maps.
	column 'market_id'
		dataType: string
		summarizeBy: none
		sourceColumn: market_id
		lineageTag: 97ea0f0a-3a9a-5874-8b7b-800141e206e9
		isHidden
		isAvailableInMdx: false

	/// Geographic operating region (such as East or West) for regional grouping and row-level security.
	column 'region'
		dataType: string
		summarizeBy: none
		sourceColumn: region
		lineageTag: ce991efc-eacf-50eb-a33e-dc627c996052

	/// Current marketing contact preference flag; does not reconstruct historical campaign eligibility.
	column 'consent'
		dataType: boolean
		summarizeBy: none
		sourceColumn: consent
		lineageTag: ffbe9802-37c9-5398-91f5-dd6b087e9cd0

	/// True for business accounts eligible for service contracts; false for consumer accounts.
	column 'enterprise'
		dataType: boolean
		summarizeBy: none
		sourceColumn: enterprise
		lineageTag: 0647ba0f-eb70-5913-bf78-fcb117271726

	/// Customer-facing account label; deliberately non-unique across accounts, never use as a join key.
	column 'display_name'
		dataType: string
		summarizeBy: none
		sourceColumn: display_name
		lineageTag: a2ee1162-cd3c-5b87-a782-437de62e62f6

	partition 'Accounts' = entity
		mode: directLake
		source
			entityName: account
			schemaName: dbo
			expressionSource: 'OneLake Source'
