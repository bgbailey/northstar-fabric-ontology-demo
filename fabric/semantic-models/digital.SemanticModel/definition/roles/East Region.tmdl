/// Synthetic East-region sample role; membership absent and configured per demo tenant.
role 'East Region'
	modelPermission: read

	tablePermission 'Sessions' = 'Sessions'[market_id] = "M01"
	tablePermission 'Interaction Events' = 'Interaction Events'[market_id] = "M01"
	tablePermission 'Accounts' = 'Accounts'[region] = "East"
	tablePermission 'Markets' = 'Markets'[region] = "East"
