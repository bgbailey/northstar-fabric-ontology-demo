/// Synthetic fulfilment locations.
table 'Stores'
	lineageTag: cecc434c-eaf7-55e6-935c-c6540ed6a3ee

	/// Technical identity; join only through the declared mapping.
	column 'store_key'
		dataType: int64
		summarizeBy: none
		sourceColumn: store_key
		lineageTag: 19fbafb2-6403-553f-acfd-4ea0fd075006
		isHidden
		isAvailableInMdx: false
		isKey
		formatString: #,##0

	/// Store name at the declared Stores grain.
	column 'store_name'
		dataType: string
		summarizeBy: none
		sourceColumn: store_name
		lineageTag: 839a70ff-a544-599e-88b5-83f22b03af71

	/// Technical identity; join only through the declared mapping.
	column 'market_id'
		dataType: string
		summarizeBy: none
		sourceColumn: market_id
		lineageTag: cf93015f-f58c-5a98-8679-97f7b409298a
		isHidden
		isAvailableInMdx: false

	partition 'Stores' = entity
		mode: directLake
		source
			entityName: store
			schemaName: dbo
			expressionSource: 'OneLake Source'
