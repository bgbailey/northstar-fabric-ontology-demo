/// Registered accounts, not active accounts; names are deliberately nonunique.
table 'Accounts'
	lineageTag: 30c2f55c-6c79-5990-a6a3-8e844866f9a9

	/// Hidden technical identifier; join only through declared relationships or identity maps.
	column 'account_key'
		dataType: int64
		summarizeBy: none
		sourceColumn: account_key
		lineageTag: ad18993e-4407-5f73-9976-0dc85651b167
		isHidden
		isAvailableInMdx: false
		isKey
		formatString: #,##0

	/// Hidden technical identifier; join only through declared relationships or identity maps.
	column 'account_id'
		dataType: string
		summarizeBy: none
		sourceColumn: account_id
		lineageTag: 114e21f6-1514-5714-9497-11859dfc60af
		isHidden
		isAvailableInMdx: false

	/// Hidden technical identifier; join only through declared relationships or identity maps.
	column 'market_id'
		dataType: string
		summarizeBy: none
		sourceColumn: market_id
		lineageTag: 7ce92771-e352-5fbb-93a3-4ada024d8a88
		isHidden
		isAvailableInMdx: false

	/// Geographic operating region (such as East or West) for regional grouping and row-level security.
	column 'region'
		dataType: string
		summarizeBy: none
		sourceColumn: region
		lineageTag: b763fdcd-47fd-543d-8d9d-fb787f47ed33

	/// Current marketing contact preference flag; does not reconstruct historical campaign eligibility.
	column 'consent'
		dataType: boolean
		summarizeBy: none
		sourceColumn: consent
		lineageTag: 747fa805-aa2e-5313-8982-3f79a599fcb9

	/// True for business accounts eligible for service contracts; false for consumer accounts.
	column 'enterprise'
		dataType: boolean
		summarizeBy: none
		sourceColumn: enterprise
		lineageTag: c6ee632e-d739-5216-8ab1-44a37de1f771

	/// Customer-facing account label; deliberately non-unique across accounts, never use as a join key.
	column 'display_name'
		dataType: string
		summarizeBy: none
		sourceColumn: display_name
		lineageTag: 3d0c0c56-82eb-5926-9cdb-a79bed8320bc

	partition 'Accounts' = entity
		mode: directLake
		source
			entityName: account
			schemaName: dbo
			expressionSource: 'OneLake Source'
