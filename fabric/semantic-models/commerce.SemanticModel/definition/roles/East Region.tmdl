/// Synthetic East-region sample role; membership absent and configured per demo tenant.
role 'East Region'
	modelPermission: read

	tablePermission 'Orders' = 'Orders'[market_id] = "M01"
	tablePermission 'Order Lines' = 'Order Lines'[market_id] = "M01"
	tablePermission 'Store Device Day' = 'Store Device Day'[market_id] = "M01"
	tablePermission 'Accounts' = 'Accounts'[region] = "East"
	tablePermission 'Markets' = 'Markets'[region] = "East"
	tablePermission 'Stores' = 'Stores'[market_id] = "M01"
