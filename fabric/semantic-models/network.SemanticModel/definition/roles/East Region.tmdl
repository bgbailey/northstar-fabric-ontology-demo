/// Synthetic East-region sample role; membership absent and configured per demo tenant.
role 'East Region'
	modelPermission: read

	tablePermission 'Incidents' = 'Incidents'[market_id] = "M01"
	tablePermission 'Site Hour' = 'Site Hour'[market_id] = "M01"
	tablePermission 'Site Day' = 'Site Day'[market_id] = "M01"
	tablePermission 'Subscription Site Exposure' = 'Subscription Site Exposure'[market_id] = "M01"
	tablePermission 'Accounts' = 'Accounts'[region] = "East"
	tablePermission 'Markets' = 'Markets'[region] = "East"
	tablePermission 'Sites' = 'Sites'[region] = "East"
