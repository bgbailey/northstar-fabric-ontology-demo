/// Network Operations; undeployed template requiring approved OneLake binding.
model Model
	culture: en-US
	sourceQueryCulture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	annotation LiveDax = NOT_RUN
	annotation DirectLake = NOT_RUN
	annotation SourceRls = NOT_RUN
	annotation SourceRevision = 1.0

ref table 'Incidents'
ref table 'Site Hour'
ref table 'Site Day'
ref table 'Subscription Site Exposure'
ref table 'Accounts'
ref table 'Calendar'
ref table 'Markets'
ref table 'Sites'

ref role 'East Region'
