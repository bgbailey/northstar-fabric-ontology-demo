/// Registered accounts, not active accounts; names are deliberately nonunique.
table 'Accounts'
	lineageTag: 5d645dd7-2d7b-5cac-8c57-6acee0e6ab48

	/// Technical identity; join only through the declared mapping.
	column 'account_key'
		dataType: int64
		summarizeBy: none
		sourceColumn: account_key
		lineageTag: 936401eb-996a-56fa-aa45-7211d3b9ca3c
		isHidden
		isAvailableInMdx: false
		isKey
		formatString: #,##0

	/// Technical identity; join only through the declared mapping.
	column 'account_id'
		dataType: string
		summarizeBy: none
		sourceColumn: account_id
		lineageTag: 6d01e526-12d7-5d0f-af90-6e5623d0a5ed
		isHidden
		isAvailableInMdx: false

	/// Technical identity; join only through the declared mapping.
	column 'market_id'
		dataType: string
		summarizeBy: none
		sourceColumn: market_id
		lineageTag: e6a2c187-743b-50af-92a8-6d74dc8a4b2d
		isHidden
		isAvailableInMdx: false

	/// Region at the declared Accounts grain.
	column 'region'
		dataType: string
		summarizeBy: none
		sourceColumn: region
		lineageTag: fb67ab7a-a67b-5b6a-9048-e93166e34ad7

	/// Consent at the declared Accounts grain.
	column 'consent'
		dataType: boolean
		summarizeBy: none
		sourceColumn: consent
		lineageTag: d4f26e2c-0931-5c1f-8921-ab0c4236b05e

	/// Enterprise at the declared Accounts grain.
	column 'enterprise'
		dataType: boolean
		summarizeBy: none
		sourceColumn: enterprise
		lineageTag: 92a43c45-0a92-5cd5-adc2-5ee89e148bae

	/// Display name at the declared Accounts grain.
	column 'display_name'
		dataType: string
		summarizeBy: none
		sourceColumn: display_name
		lineageTag: e9820201-8778-565d-9161-1cf131ec06ab

	partition 'Accounts' = entity
		mode: directLake
		source
			entityName: account
			schemaName: dbo
			expressionSource: 'OneLake Source'
