/// Four synthetic home markets; home market is not network exposure.
table 'Markets'
	lineageTag: 80cd1c18-abda-540b-92ca-cedcbcb455c5

	/// Technical identity; join only through the declared mapping.
	column 'market_id'
		dataType: string
		summarizeBy: none
		sourceColumn: market_id
		lineageTag: 77d5c593-8513-5d37-b1c8-0552ccc08681
		isHidden
		isAvailableInMdx: false
		isKey

	/// Market name at the declared Markets grain.
	column 'market_name'
		dataType: string
		summarizeBy: none
		sourceColumn: market_name
		lineageTag: ef7264ba-afa6-5499-87b4-09487c09a496

	/// Region at the declared Markets grain.
	column 'region'
		dataType: string
		summarizeBy: none
		sourceColumn: region
		lineageTag: 72ffa4e2-e255-5fdc-b09b-f388f017569e

	partition 'Markets' = entity
		mode: directLake
		source
			entityName: market
			schemaName: dbo
			expressionSource: 'OneLake Source'
