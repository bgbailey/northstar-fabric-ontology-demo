/// Contiguous daily calendar covering service and late posting dates.
table 'Calendar'
	lineageTag: b1e8524f-d4a6-586d-aba1-e1b32c98e89b
	dataCategory: Time

	/// Calendar date with no timezone or time-of-day.
	column 'date'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: date
		lineageTag: 7a9ee7a4-6560-5759-b224-066802cdbf9c
		isKey
		formatString: yyyy-MM-dd

	/// Year at the declared Calendar grain.
	column 'year'
		dataType: int64
		summarizeBy: none
		sourceColumn: year
		lineageTag: b71870cc-2fa3-5504-b85e-a778c8405868
		formatString: #,##0

	/// Quarter at the declared Calendar grain.
	column 'quarter'
		dataType: int64
		summarizeBy: none
		sourceColumn: quarter
		lineageTag: 5685607b-542c-530c-b604-e9163b0a5c41
		formatString: #,##0

	/// Month number at the declared Calendar grain.
	column 'month_number'
		dataType: int64
		summarizeBy: none
		sourceColumn: month_number
		lineageTag: a4c231b0-e387-5d8c-baf5-7eaec204c09f
		formatString: #,##0

	/// Month name at the declared Calendar grain.
	column 'month_name'
		dataType: string
		summarizeBy: none
		sourceColumn: month_name
		lineageTag: b7c6342c-ecaa-5898-94a5-154599a3e687
		sortByColumn: 'month_number'

	/// Day at the declared Calendar grain.
	column 'day'
		dataType: int64
		summarizeBy: none
		sourceColumn: day
		lineageTag: 883e6c27-8a7b-5fea-a2a8-669e02aa478d
		formatString: #,##0

	partition 'Calendar' = entity
		mode: directLake
		source
			entityName: calendar_date
			schemaName: dbo
			expressionSource: 'OneLake Source'
