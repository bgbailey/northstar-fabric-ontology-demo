/// Offers and Retention; undeployed template requiring approved OneLake binding.
model Model
	culture: en-US
	sourceQueryCulture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	annotation LiveDax = NOT_RUN
	annotation DirectLake = NOT_RUN
	annotation SourceRls = NOT_RUN
	annotation SourceRevision = 1.0

ref table 'Offer Assignments'
ref table 'Offer Outcomes'
ref table 'Campaign Touches'
ref table 'Accounts'
ref table 'Calendar'
ref table 'Campaigns'
ref table 'Markets'

ref role 'East Region'
